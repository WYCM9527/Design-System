{
  "description": "旧规范 → morganite 的角色对照（机器可读版，由 web-to-design-system 生成）。migrate --phase settle 起草决策文件时用它：按角色映射，不按色值找最接近的灰。properties 是该角色出现的 CSS 属性上下文；hints 是旧变量名 / 注释里常见的字样——这里只有通用词，请把旧系统独有的变量名与色值补进去。noEquivalent 列旧系统里在新系统没有对应物的东西（如某种深色 hover、淡色选中底）及替代写法，由维护者按 DESIGN.md 填写。",
  "noEquivalent": [
    {
      "legacy": "HTML 内联样式",
      "note": "guard 会把内联字面量算作 Drift。",
      "replacement": "抽成 class 再引用 token",
      "var": null
    },
    {
      "legacy": "antd 菜单选中态：主色 1 阶浅底 + 主色文字（Menu itemSelectedBg）",
      "note": "Ant Design Pro 的侧栏本来是中性浅灰；本系统亮色侧栏当前项是主色底块 + 白字（用户指定），暗色是金色暗底 + 亮金字。",
      "replacement": "color.bg.sidebar-selected + color.text.sidebar-selected（暗色 delta 为金色暗底 + 亮金字）",
      "var": "--color-bg-sidebar-selected"
    },
    {
      "legacy": "antd 主色按钮白字（colorTextLightSolid）",
      "note": "本系统同样金底白字（用户指定）；白字对主色只有 3.02:1，已登记为例外。",
      "replacement": "color.text.on-primary（白字）",
      "var": "--color-text-on-primary"
    },
    {
      "legacy": "antd 警示金黄（colorWarning #faad14 一族）",
      "note": "与品牌金同色相，改用 antd 橙色系。",
      "replacement": "color.status.warning / color.status.warning-bg",
      "var": "--color-status-warning"
    },
    {
      "legacy": "描边式输入框边线（variant outlined）",
      "note": "本系统输入框为填充式，静息无边线；悬停才出现边线。",
      "replacement": "color.bg.input；悬停 color.border.strong，聚焦 color.border.focus",
      "var": "--color-bg-input"
    },
    {
      "legacy": "antd 按钮底部 2px 投影（primaryShadow / defaultShadow）",
      "note": "不纳管。",
      "replacement": "去掉，不补 token",
      "var": null
    }
  ],
