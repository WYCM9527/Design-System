{
  "$schema": "https://raw.githubusercontent.com/WYCM9527/Design-System/main/design-system-adopter/schema/design-system.schema.json",
  "id": "morganite",
  "name": "Morganite 玫瑰金",
  "version": "0.3.4",
  "description": "中后台 · Ant Design Pro v6 底座 · 玫瑰金 #B98D44 金底白字 + antd 纯灰骨架 · 亮 / 暗 · Element Plus / shadcn/ui / ECharts 桥接",
  "upstream": {
    "repo": "WYCM9527/Design-System",
    "path": "morganite/seeds/morganite",
    "tagPrefix": "morganite-v",
    "npm": "@wycm9527/morganite"
  },
  "docs": {
    "design": "design-system/DESIGN.md",
    "changelog": "CHANGELOG.md",
    "readme": "README.md"
  },
  "stacks": {
    "css": {
      "label": "纯 CSS（任意栈）",
      "entry": "bridge/base.css",
      "extra": [],
      "snippet": "templates/entry-css.css",
      "notes": "templates/notes-css.md",
      "detect": {
        "files": []
      }
    },
    "element-plus": {
      "label": "Vue 3 + Element Plus",
      "entry": "bridge/element-plus.css",
      "extra": [
        "bridge/iconpark.css",
        "bridge/recipes.css"
      ],
      "components": "bridge/vue",
      "snippet": "templates/entry-element-plus.css",
      "notes": "templates/notes-element-plus.md",
      "scaffold": "npm create vite@latest <name> -- --template vue && cd <name> && npm i element-plus @icon-park/vue-next vue-router echarts",
      "kitchen": "bridge/vue/KitchenSink.vue",
      "detect": {
        "deps": [
          "element-plus"
        ]
      }
    },
    "shadcn": {
      "label": "React + Tailwind v4 + shadcn/ui",
      "entry": "bridge/shadcn.css",
      "extra": [
        "bridge/recipes.css"
      ],
      "components": "bridge/react",
      "snippet": "templates/entry-shadcn.css",
      "notes": "templates/notes-shadcn.md",
      "scaffold": "npm create vite@latest <name> -- --template react-ts && cd <name> && npm i lucide-react echarts && npm i -D tailwindcss @tailwindcss/vite",
      "kitchen": "templates/KitchenSink.tsx",
      "detect": {
        "deps": [
          "class-variance-authority",
          "shadcn"
        ],
        "files": [
          "components.json"
        ]
      }
    }
  },
  "export": {
    "note": "纯 CSS 交付：非 Node 项目用 ds.mjs export --to <static 目录> 得到 index.css + base.css，按顺序 <link>，项目样式只引用变量。base.css 会自己引入同目录的 fonts.css（数字字体 D-DIN），几个文件放在同一目录、一起部署。",
    "core": [
      "design-system/dist/index.css",
      "bridge/base.css",
      "bridge/fonts.css",
      "bridge/recipes.css"
    ],
    "optional": {
      "element-plus": [
        "bridge/element-plus.css",
        "bridge/iconpark.css"
      ],
      "shadcn": [
        "bridge/shadcn.css"
      ]
    },
    "usage": "<link rel=\"stylesheet\" href=\"index.css\">  <!-- token（默认模式）+ 其他模式 delta -->\n<link rel=\"stylesheet\" href=\"base.css\">   <!-- 基础桥接：body / 标题 / 链接 / 表单控件 / 焦点 / 减少动态效果 -->\n<link rel=\"stylesheet\" href=\"你的样式.css\">  <!-- 只引用 var(--color-*) / var(--spacing-*) 等变量，不写色值与像素 -->"
  },
  "migration": {
    "roles": "migration/roles.json",
    "guide": "README.md#从旧规范迁移"
  },
  "agents": "templates/AGENTS.md",
  "build": {
    "tool": "style-dictionary@5.5.2",
    "steward": "design-system-steward"
  },
  "accept": {
    "npm": "@wycm9527/citrine-tools",
    "command": "citrine-accept all",
    "configTemplate": "templates/accept.config.mjs",
    "brand": {
      "name": "品牌金",
      "note": "主按钮 / 勾选开关选中 / 进度滑杆评分 / 页签 / 侧栏当前项 / 当前页码 / 选中日与选中项 / 步骤与时间线 / 主色徽标与深色标签 / 筹码 / 链接 / 头像 / 图表 / 登录品牌区 / 优惠券券面",
      "hue": [30, 45],
      "saturation": [0.35, 0.8],
      "lightness": [0.25, 0.75],
      "focusRing": true,
      "hoverAllow": [
        ".el-link",
        ".crumbs a",
        ".title-link"
      ],
      "allow": {
        "element-plus": [
          ".el-button--primary:not(.is-plain):not(.is-text):not(.is-link)",
          ".el-button.is-link",
          ".el-link--primary",
          ".el-checkbox__input.is-checked",
          ".el-checkbox__input.is-indeterminate",
          ".el-checkbox.is-bordered.is-checked",
          ".el-radio__input.is-checked",
          ".el-radio.is-bordered.is-checked",
          ".el-switch.is-checked .el-switch__core",
          ".el-progress-bar__inner",
          ".el-progress-circle__path",
          ".el-slider__bar",
          ".el-slider__button",
          ".el-rate",
          ".el-tabs__item.is-active",
          ".el-tabs__active-bar",
          ".el-menu-item.is-active",
          ".el-pager li.is-active",
          ".el-select-dropdown__item.is-selected",
          ".el-cascader-node.is-active",
          ".el-cascader-node.in-active-path",
          ".time-select-item.selected",
          ".el-date-table td.current",
          ".el-date-table td.start-date",
          ".el-date-table td.end-date",
          ".el-month-table td.current",
          ".el-year-table td.current",
          ".el-step__head.is-process",
          ".el-step__head.is-finish",
          ".el-step__head.is-success",
          ".el-timeline-item__node--primary",
          ".el-badge__content--primary",
          ".el-tag--dark.el-tag--primary",
          ".el-tag.is-hit",
          ".el-check-tag--primary.is-checked",
          ".el-avatar",
          ".el-upload__text em",
          ".el-anchor__link.is-active",
          ".el-anchor__marker",
          ".el-table .ascending .sort-caret.ascending",
          ".el-table .descending .sort-caret.descending",
          ".el-table-filter__list-item.is-active",
          ".el-table th.el-table__cell > .cell.highlight",
          ".el-result .icon-primary",
          ".el-tour-indicator.is-active",
          ".el-color-predefine__color-selector.selected"
        ],
        "recipes": [
          ".link",
          ".act",
          ".go",
          ".app-brand .logo",
          ".nav a.active",
          ".nav button.active",
          ".iconbtn.is-on",
          ".avatar",
          ".badge.brand",
          ".chip",
          ".page[aria-current=\"page\"]",
          ".confirm-bar__btn.is-primary",
          ".result .code",
          ".result .illu",
          ".empty .illu",
          ".i-icon--brand",
          ".login-brand",
          ".coupon-value",
          ".c1",
          ".c3",
          ".goals .fill",
          ".stat-strip .cell.is-active"
        ],
        "shadcn": [
          "[data-slot=\"button\"].bg-primary",
          "[data-slot=\"badge\"].bg-primary",
          "[data-slot=\"checkbox\"][data-state=\"checked\"]",
          "[data-slot=\"checkbox\"][data-state=\"indeterminate\"]",
          "[data-slot=\"radio-group-item\"][data-state=\"checked\"]",
          "[data-slot=\"switch\"][data-state=\"checked\"]",
          "[data-slot=\"progress-indicator\"]",
          "[data-slot=\"slider-range\"]",
          "[data-slot=\"slider-thumb\"]",
          "[data-slot=\"select-item\"][data-state=\"checked\"]",
          "[data-slot=\"pagination-link\"][data-active=\"true\"]",
          "[data-slot=\"pagination-link\"][aria-current=\"page\"]"
        ]
      }
    }
  },
  "owned": [
    "design-system/DESIGN.md",
    "design-system/AUDIT.md",
    "design-system/style-dictionary.config.mjs",
    "design-system/scope-map.json",
    "design-system/theme-map.json",
    "design-system/tokens/**",
    "design-system/themes/**",
    "design-system/preview/preview.local.css",
    "bridge/**",
    "templates/**",
    "migration/**"
  ],
  "type": "admin"
}
