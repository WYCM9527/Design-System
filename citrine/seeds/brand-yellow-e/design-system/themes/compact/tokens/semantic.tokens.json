{
  "control": {
    "height": {
      "md": {
        "$type": "dimension",
        "$value": "{size.control.sm}"
      },
      "sm": {
        "$type": "dimension",
        "$value": "{size.control.xs}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{size.control.md}",
        "$description": "紧凑下侧栏菜单项、登录页大控件从 40 收到 34，与内容区密度一致。"
      }
    }
  },
  "space": {
    "stack": {
      "$type": "dimension",
      "$value": "{spacing.3}"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "{spacing.4}"
    },
    "card": {
      "$type": "dimension",
      "$value": "{spacing.4}"
    }
  },
  "table": {
    "cell": {
      "padding-y": {
        "$type": "dimension",
        "$value": "{spacing.2}"
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{spacing.3}"
      }
    }
  }
}
