{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "design-system.json（设计系统身份文件）",
  "description": "放在设计系统分发包根目录。design-system-adopter 靠它识别、接入与更新；缺 id / version / upstream / stacks 的目录一律视为用户自建，不纳管。",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "upstream",
    "stacks",
    "owned"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "系统唯一 id：快照目录名 design-systems/<id>/、tag 前缀的一部分"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "系统类型 id：这套规范给什么类型的产品用（内置 website 通用网站 / product 产品应用 / admin 中后台，公司可在 Design-System 仓库 system-types/ 自定义）。由 web-to-design-system 写入，adopter 只当元数据展示；可缺省。"
    },
    "upstream": {
      "type": "object",
      "required": [
        "repo",
        "path",
        "tagPrefix"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "description": "GitHub <owner>/<repo>"
        },
        "path": {
          "type": "string",
          "description": "仓库内的包子路径"
        },
        "tagPrefix": {
          "type": "string",
          "description": "版本 tag 前缀，如 citrine-v"
        },
        "npm": {
          "type": "string",
          "description": "npm 包名（可选渠道；也是 bridge import 的路径前缀）"
        }
      }
    },
    "docs": {
      "type": "object",
      "properties": {
        "design": {
          "type": "string"
        },
        "changelog": {
          "type": "string"
        },
        "readme": {
          "type": "string"
        }
      }
    },
    "stacks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "entry",
          "snippet",
          "notes"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "entry": {
            "type": "string",
            "description": "该栈的桥接入口 CSS（相对包根）"
          },
          "extra": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "components": {
            "type": "string",
            "description": "配方组件目录"
          },
          "snippet": {
            "type": "string",
            "description": "样式入口模板（{{BRIDGE}} / {{DIST}} 占位）"
          },
          "notes": {
            "type": "string",
            "description": "接线要点（AGENTS 模板的 {{STACK_NOTES}} 填充物，{{BRIDGE}} / {{IMPORT}} 占位）"
          },
          "scaffold": {
            "type": "string",
            "description": "空目录起应用骨架的一行命令（骨架不属于设计系统，仅提示）"
          }
        }
      }
    },
    "accept": {
      "type": "object",
      "properties": {
        "npm": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "configTemplate": {
          "type": "string"
        },
        "brand": {
          "type": "object",
          "description": "品牌色审计口径（citrine-tools ≥ 1.3.0 读取，见 citrine/tools/README「品牌色口径」）：判色范围 + 静息态允许出现品牌色的位置。缺省时 Citrine 用内置的品牌黄，别的系统不审计。",
          "required": ["hue", "saturation", "lightness"],
          "properties": {
            "name": { "type": "string", "description": "报告里的称呼，如「品牌金」" },
            "note": { "type": "string", "description": "允许位置的一句话概括，写在失败信息里" },
            "hue": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "色相范围（度），写 [最小, 最大]" },
            "saturation": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "饱和度范围（0–1），写 [最小, 最大]" },
            "lightness": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "明度范围（0–1），写 [最小, 最大]" },
            "focusRing": { "type": "boolean", "description": "焦点指示本身是品牌色：组件走查不把聚焦时出现在外环 / 环形阴影 / 边线上的品牌色算作泄漏" },
            "hoverAllow": { "type": "array", "items": { "type": "string" }, "description": "悬停时允许新出现品牌色的元素（CSS 选择器）" },
            "allow": {
              "description": "静息态允许出现品牌色的位置（CSS 选择器）：数组，或按技术栈分组的对象",
              "oneOf": [
                { "type": "array", "items": { "type": "string" } },
                { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
              ]
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "string",
          "description": "旧规范 → 新 token 的角色对照（机器可读）"
        },
        "guide": {
          "type": "string"
        }
      }
    },
    "agents": {
      "type": "string",
      "description": "AGENTS.md 模板路径"
    },
    "build": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "steward": {
          "type": "string"
        }
      }
    },
    "owned": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "上游拥有、随版本升级的文件 glob（相对包根）；工作副本里其余文件（exemptions / MIGRATION / scopes / dist）归项目，升级永不触碰"
    },
    "palettes": {
      "type": "object",
      "description": "颜色主题（调色盘）：结构只有一套，一个颜色一个文件（<dir>/<id>.json，格式见 palette.schema.json），只改已有 token 的值——品牌色原语整组换掉，加上 roles 里登记的角色改指向。默认颜色不建文件，种子现值就是它。ds.mjs init --palette / palette 读取。",
      "required": ["default", "roles"],
      "properties": {
        "dir": { "type": "string", "description": "调色盘目录（相对包根），缺省 palettes" },
        "group": { "type": "string", "description": "品牌色原语所在的组，缺省 color.brand；调色盘必须给齐这一组的每一档" },
        "swatch": { "type": "string", "description": "代表色取哪一档（列表与面板里的色块），缺省 <group>.500" },
        "default": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "name": { "type": "string" }
          }
        },
        "official": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": "官方名单（含默认颜色，顺序即展示顺序）：ds.mjs palette 只接受名单里的；其余调色盘只在预览面板里试，用之前先提案"
        },
        "theme": { "type": "string", "description": "调色盘可以写暗色覆写的主题 id（theme-map.json 里的暗色主题）" },
        "preview": { "type": "string", "description": "在线效果预览网址（支持 ?palette=<id> 直接换色）：ds.mjs palette --list 打印「先看效果」的链接" },
        "roles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "调色盘可以改指向的语义角色（亮色核心与暗色覆写共用一份名单）。换色时这些键整体归调色盘管：先恢复成种子默认值，再写调色盘的值"
        }
      }
    },
    "export": {
      "type": "object",
      "description": "纯 CSS 交付：core 是必带文件（相对包根，顺序即 link 顺序），optional 是按栈可选的桥接组，usage 是打印给用户的接线片段",
      "required": [
        "core"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "core": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "usage": {
          "type": "string"
        }
      }
    }
  }
}
